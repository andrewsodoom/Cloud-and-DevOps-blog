# Runtime (API)
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/cloudcraft
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=cloudcraft_token

# Public site URL used for canonicals, sitemap, RSS, and Open Graph tags.
# Set this to your production domain, for example https://cloudcraftjournal.com.
# PUBLIC_SITE_URL=http://localhost:8080
# VITE_SITE_URL=http://localhost:8080

# Public URL used to build uploaded image links. When the site and API share a
# domain, use the same value as PUBLIC_SITE_URL.
# PUBLIC_API_URL=http://localhost:8080
# UPLOAD_DIR=./server/uploads

# Optional AI suggestions. Without a key, local suggestions are used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Docker Compose hosting
# SITE_ADDRESS is what Caddy serves. Use a bare hostname for automatic HTTPS,
# or leave it unset to serve plain HTTP on http://localhost.
# DNS must point at the server and ports 80 and 443 must be open.
# SITE_ADDRESS=cloudcraftjournal.com
# PUBLIC_SITE_URL=https://cloudcraftjournal.com
# PUBLIC_API_URL and DOCKER_CLIENT_ORIGIN default to PUBLIC_SITE_URL when unset.
# PUBLIC_API_URL=https://cloudcraftjournal.com
# DOCKER_CLIENT_ORIGIN=https://cloudcraftjournal.com
# Set to true when the site is served over HTTPS. Required for secure cookies.
# COOKIE_SECURE=true
# Host port for the web container, bound to 127.0.0.1. Caddy is the public edge.
# WEB_PORT=8080

# Optional: only used by `npm run seed` or the seed command in the README
# to create an admin and demo posts.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace-with-at-least-8-characters
